// A patch on a star system: "bodies" is a list of named objects, so it merges by name. Shard's orbit changes one
// value; Kiln is new and goes on the end.
{
  "patch": "Frostreach",
  "bodies": [
    { "name": "Shard", "orbit": { "e": 0.1 } },
    {
      "name": "Kiln", "parent": "Frostreach", "radius": 3000, "gravity": 8, "color": [0.55, 0.4, 0.3],
      "orbit": { "au": 0.8, "e": 0.03, "i": 1, "lan": 200, "argp": 10, "m0": 90 },
      "rotation": { "hours": 20, "tilt": 12 }
    }
  ]
}
