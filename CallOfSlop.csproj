<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType> <!-- no console window; output goes to callofslop.log -->
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>CallOfSlop</RootNamespace>
    <AssemblyName>CallOfSlop</AssemblyName>
    <!-- The BRUTAL natives ship for win-x64 and linux-x64. -->
    <PlatformTarget>x64</PlatformTarget>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <!-- Windowing + input -->
    <PackageReference Include="Ahwoo.BRUTAL.Glfw" Version="2026.10.4" />
    <!-- Rendering (OpenGL 4.1 core via GLAD) -->
    <PackageReference Include="Ahwoo.BRUTAL.OpenGl" Version="2026.10.1" />
    <!-- Networking -->
    <PackageReference Include="Ahwoo.BRUTAL.RakNet" Version="2026.10.2" />
    <!-- Loadout menu + HUD text (Dear ImGui with GLFW/OpenGL backends) -->
    <PackageReference Include="Ahwoo.BRUTAL.ImGui" Version="2026.10.2" />
    <PackageReference Include="Ahwoo.BRUTAL.ImGui.Backends" Version="2026.10.2" />
    <!-- 3D weapon audio (OpenAL Soft) -->
    <PackageReference Include="Ahwoo.BRUTAL.OpenAl" Version="2026.10.2" />
    <!-- Mesh pipeline: glTF 2.0 parsing (managed; brings Brutal.Texture for image decoding) and meshoptimizer
         (vertex cache optimisation, LOD simplification). Both natives are canary-checked at runtime, with fallbacks. -->
    <PackageReference Include="Ahwoo.BRUTAL.Gltf" Version="2026.10.2" />
    <PackageReference Include="Ahwoo.BRUTAL.MeshOptimizer" Version="2026.10.1" />
  </ItemGroup>

  <ItemGroup>
    <!-- BRUTAL licence section 2.3: ship NOTICE.txt alongside the product. -->
    <None Include="NOTICE.txt" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Branding\**\*" CopyToOutputDirectory="PreserveNewest" /> <!-- the BRUTAL logo (licence section 2.2) -->
    <!-- Maps are data files: everything in Maps\ is copied next to the game and loaded at startup. -->
    <None Update="Maps\**\*" CopyToOutputDirectory="PreserveNewest" />
    <!-- Weapons and attachments are data files too: one JSON file each, loaded at startup (see Weapons\README.md). -->
    <None Update="Weapons\**\*" CopyToOutputDirectory="PreserveNewest" />
    <None Update="Attachments\**\*" CopyToOutputDirectory="PreserveNewest" />
    <!-- Zombies weapon builder parts: one JSON file each (see docs\zombies\WEAPON-BUILDER.md). -->
    <None Update="Parts\**\*" CopyToOutputDirectory="PreserveNewest" />
    <!-- Map props (trash cans, crates, litter...): one JSON file each, in category folders (see Props\README.md). -->
    <None Update="Props\**\*" CopyToOutputDirectory="PreserveNewest" />
    <!-- Buildings for the Building map op: one folder each (building.json, its own Props and Furnishing), plus shared Furnishing rules (see Buildings\README.md). -->
    <None Update="Buildings\**\*" CopyToOutputDirectory="PreserveNewest" />
    <!-- Models (.glb / .gltf) for the Mesh and Model map ops (see Models\README.md). -->
    <None Update="Models\**\*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
