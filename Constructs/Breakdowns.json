{
  // Breakdowns on ships (Source/Game/GameSandboxBreakdowns.cs, docs/sandbox/constructs/ship.md "Breakdowns"): the roadmap's
  // "breakdowns that warn you first" (Karl, 2026-11-15). Survival only, on every crewed player ship (Karl, 2026-11-16), each
  // with its own clock that runs only while somebody alive is aboard it. A breakdown picks a hull drive's works piece (its
  // Drive Core, Fuel Pump, Coolant Exchanger) or a thruster with no works inside (a pod, a whole jet).
  "format": "call-of-slop-breakdowns/1",
  "minMinutes": 8, // crewed minutes from one breakdown's warning to the next: a random time between these two
  "maxMinutes": 14,
  "firstMinutes": 4, // the first one comes this soon after you wake (crewed minutes), so the start shows what to look out for
  "warnSeconds": 90, // how long a part creaks and groans before it fails: fix it with the attach tool in that time for nothing
  "repairMaterial": "metal", // what a failed part takes to put right (Recycling.json's materials: salvage gives metal)
  "repairCost": 3,
  "maxFailed": 2 // no new breakdown starts on a ship while this many of its parts are already failed and waiting for a repair
}
