{
  // Robot shells as frames and modules (Source/Constructs/ShellFrames.cs; docs/sandbox/design/mining-shell.md "Modular shells";
  // the user, 2026-11-17). A frame is a shell body: the part that stands as it, its size ("scale", 1 a person), its pace
  // ("speed", times a person's), the hits it takes ("damage", times a person's), the jobs it suits and the module in each slot.
  // "fixed" slots can't be changed by customisation (none can be changed yet). A frame's place in the list is its byte on the
  // wire: frame 0 is the Robot Shell with the numbers every shell had before; a new frame goes at the end.
  "format": "call-of-slop-shells/1",
  "slots": ["head", "back", "leftArm", "rightArm"], // the order is the wire's: a new slot goes at the end
  // A module's "kind" is what the code knows: head, pack, hopper (the shell part's own bin is the hopper; "takes" what it
  // holds), hand (holds the tools), drill (always out: while ground drill scoops land on a deposit a Drill Module of "tier"
  // works, it taps "rate" units a second of its ore into the hopper).
  "modules": [
    { "name": "Optics Head", "slot": "head", "kind": "head" },
    { "name": "Power Pack", "slot": "back", "kind": "pack" },
    { "name": "Ore Hopper", "slot": "back", "kind": "hopper", "takes": ["iron ore", "copper ore", "gold ore", "levite ore", "stone", "sand"] },
    { "name": "Hand", "slot": "arm", "kind": "hand" },
    { "name": "Drill Arm", "slot": "arm", "kind": "drill", "rate": 20, "tier": 2 }
  ],
  "frames": [
    { "name": "Standard", "part": "Robot Shell", "scale": 1, "speed": 1, "damage": 1,
      "slots": { "head": "Optics Head", "back": "Power Pack", "leftArm": "Hand", "rightArm": "Hand" } },
    { "name": "Mining", "part": "Mining Shell", "scale": 1.5, "speed": 0.85, "damage": 0.7, "jobs": ["miner"],
      "slots": { "head": "Optics Head", "back": "Ore Hopper", "leftArm": "Hand", "rightArm": "Drill Arm" },
      "fixed": ["back", "rightArm"] }
  ]
}
