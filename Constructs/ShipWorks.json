{
  // Ship works (Source/Constructs/ConstructWorks.cs, docs/sandbox/design/ship-works.md): engines and turrets with insides.
  // A drive over jetMost has works behind it through the hull (a Drive Core, Fuel Pumps, Coolant Exchangers), or is a pod
  // with them in its cowl; what the head can push is capped by its working works. The part kit reads "drives" to write each
  // generated head's "needs", so a generator never picks the list by hand.
  "format": "call-of-slop-ship-works/1",
  "jetMost": 500000, // N: a Ship thruster over this has works (Karl, 2026-11-16: every lift jet and retro over it too)
  "bareShare": 0.25, // a thruster whose works are missing or shot out still pushes this share (Karl, 2026-11-16: it can limp)
  "jetBurn": 3, // l/s a MN: what a drive short of its works burns for what it pushes (a whole drive burns its own burnRate)
  "drives": {
    // per drive type, the thrust (N) above which each kind of works is needed: a class is a guide, not a rule in code
    "torch": { "core": 500000, "pump": 2000000, "exchanger": 6000000 },
    "rocket": { "turbopump": 500000, "manifold": 500000 },
    "ion": { "conditioner": 0 }
  },
  "mendMaterial": "metal", // a works piece broken by damage is mended with the attach tool for this (Recycling.json's materials)
  "mendPerTonne": 2, // ...this much a tonne of the piece, at least 1
  "loaderReload": 0.4, // a gun of six rounds or fewer on a Turret Ring with its Autoloaders reloads in this share of its time (a belt-fed one doesn't stop)
  "hoistSeconds": 6, // s a Reload Hoist takes to move a weapon of hoistMass from its magazine onto its launcher...
  "hoistMass": 80, // ...kg (a 25 cm missile is about that); the time grows with the square root of the mass
  "fuelBuffer": 15, // s more of full burn each Fuel Buffer in a train adds to its injector's (Sean, 2026-11-24 doc, a first figure)
  "jacketSaving": 0.1, // the share of fuel a Cooling Jacket in a train saves at the same push (once a train)
  "trainPieces": 16, // the most pieces an engine train holds, counted back from its bell
  "lightSeconds": 3, // s a bell fed through an injector takes to light from a standing start with no Igniter in its train (Sean, 2026-11-24 doc)
  "injectorBuffer": 10 // s of full burn a Fuel Injector holds: a bell fed through one (its works need an injector) whose pipe is cut runs this long, then stops (Sean, 2026-11-24)
}
