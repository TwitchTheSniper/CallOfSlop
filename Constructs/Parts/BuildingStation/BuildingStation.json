  "config": [
    {
      "key": "fillFuel",
      "label": "Fuel and tanks",
      "group": "Fill",
      "min": 0,
      "max": 100,
      "step": 5,
      "default": 100,
      "unit": "%",
      "tooltip": "Survival: a build is filled to this share. Fuel and fluid tanks, gases too: from tanks piped to Fluid in, gas from linked bins. 0: none, 100: full."
    },
    {
      "key": "fillAmmo",
      "label": "Ammo",
      "group": "Fill",
      "min": 0,
      "max": 100,
      "step": 5,
      "default": 100,
      "unit": "%",
      "tooltip": "Survival: a build is filled to this share. Ammo boxes, Ammo Containers and fitted magazines: from bulk ammo in linked bins. 0: none, 100: full."
    },
    {
      "key": "fillCharge",
      "label": "Battery charge",
      "group": "Fill",
      "min": 0,
      "max": 100,
      "step": 5,
      "default": 100,
      "unit": "%",
      "tooltip": "Survival: a build is filled to this share. Batteries: charged from the station's own power, which takes time. 0: none, 100: full."
    },
    {
      "key": "fillWait",
      "label": "Wait until filled",
      "group": "Fill",
      "type": "toggle",
      "default": false,
      "tooltip": "On: a build stays in the bay until it is filled. Off: it finishes with what it got and says what is short."
    },
    {
      "key": "subJobs",
      "label": "Sub-jobs",
      "group": "Bay",
      "type": "choice",
      "options": [
        "Off",
        "Auto",
        "Linked"
      ],
      "default": 1,
      "tooltip": "Auto: when idle it builds other stations' sub-blueprint uses on this construct. Linked: also uses sent over a logistics link (the module goes by cargo ship). Off: only your own builds."
    },
    {
      "key": "dressSalt",
      "label": "Dress salt",
      "group": "Dress",
      "min": 0,
      "max": 99,
      "step": 1,
      "default": 0,
      "tooltip": "Which of the style's panel patterns goes where: another number is another layout. Both sides of a ship match on one salt."
    },
    {
      "key": "dressExtras",
      "label": "Dress extras",
      "group": "Dress",
      "type": "choice",
      "options": [
        "All",
        "No conduit",
        "No lights",
        "Bolts and vents",
        "None"
      ],
      "default": 0,
      "tooltip": "The extra bits it lays with the armour: A bolt rows and chevrons, B vents, D lights, F conduit. All: every one; None: armour, rails and the strip only."
