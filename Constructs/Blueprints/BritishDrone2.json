    {"part": "Square Beam 1 m", "on": 0, "socket": "mx011", "by": "-z", "paint": "#2b2a28"},
    {"part": "Square Beam 1 m", "on": 0, "socket": "px211", "by": "-z", "paint": "#2b2a28"},
    {"part": "Ducted Fan", "on": 1, "socket": "+y3", "by": "base", "config": {"hand": 1}},
