{
  // The faction controllers (docs/sandbox/design/faction-controllers.md section 3, phase 3): how often each thinks, the world's caps on their bodies,
  // where they lay their places on an open world, what ships cost (each blueprint's real bill: its parts' Assembling recipes down to raw units),
  // the missions' numbers, and a plan per kind. A power file's "plan" (Crew/Powers/*.json) replaces its kind's keys one by one.
  // The fleets are placeholders (Karl's answer 4: existing vehicles per role until ship and vehicle generation is settled).
  "format": "call-of-slop-npc-controllers/1",
  "think": { "seconds": 5 },
  "world": { "maxBodies": 24, "spawnFromPeople": 600, "dockFromPeople": 400, "dockRange": 150 },
  "places": { "near": 1200, "far": 2200, "razeSeconds": 180, "razeRange": 300 },
  // "goods": the share of a ship's materials (its parts' recipes down to bulk materials) its power takes from the stock of the stations it holds as it
  // builds or repairs one (Karl, 2026-11-22: "ships use goods from stations"); a material none of its stations trades isn't taken, and a power whose
  // stations are short of one waits (so cutting its supply lines starves its yards). 0: none taken.
  "cost": { "perUnit": 1, "buildSecondsScale": 0.05, "minBuildSeconds": 8, "repairShare": 1, "goods": 1 },
  "missions": {
    "convoyEveryMinutes": 4,
    "cargoValue": 900,
    "raidSight": 3000,
    "raidLoot": 0.5,
    "raidTake": 0.9,
    "callRange": 5000,
    "defendMinutes": 4,
    "quietSeconds": 40,
    "gatherMinutes": 4,
    "runMinutes": 12,
    "patrolMinutes": 8,
    "dwellSeconds": 8
  },
  "kinds": {
    "Traders": {
      "start": 4000, "income": 30, "ships": 8, "groups": 3, "places": 2,
      "fleet": { "cargo": ["4x4 Truck"], "escort": ["Hood Gun Buggy"] },
      "missions": { "convoy": { "cargo": 1, "escorts": 2 } }
    },
    "Raiders": {
      "start": 2500, "income": 10, "ships": 6, "groups": 2, "places": 1,
      "fleet": { "raider": ["Hood Gun Buggy"] },
      "missions": { "raid": { "ships": 2 } }
    },
    // The Farmers (economy step 6, 2026-11-22): a granary over Caledon and its food runs; their stock pays the runs' loads, and a truck or two works their place.
    "Farmers": {
      "start": 3000, "income": 15, "ships": 2, "groups": 1, "places": 1,
      "fleet": { "cargo": ["4x4 Truck"] },
      "missions": { "convoy": { "cargo": 1, "escorts": 0 } }
    },
    "Militia": {
      "start": 3500, "income": 25, "ships": 6, "groups": 2, "places": 1,
      "fleet": { "warship": ["Hood Gun Buggy"] },
      "missions": { "defend": { "ships": 2 } }
    }
  }
}
