    ],
    "Cinder": [
      { "name": "Ash Refinery", "kind": "refinery", "at": [15, 20], "holder": "Traders", "goods": { "hydrogen": 1400, "helium": 300, "oxidiser": 300 } },
      { "name": "Ember Mine", "kind": "mine", "at": [-25, -60], "holder": "Traders", "goods": { "iron ore": 400 } },
