{
  // Territory (docs/sandbox/design/faction-controllers.md phase 4; Karl's answer 1, 2026-11-17): the key sites of Frostreach's planets and moons, and
  // who holds each at the start. A planet belongs to the power with more than "majority" of its control; a site gives control by its kind's weight,
  // shared among the sites of that kind on that planet (one spaceport there counts for all of a spaceport's weight). Garrisons are abstract until
  // outposts are built as buildings. "at" is latitude and longitude in degrees on a planetoid (x and z on a flat map). Holders name a power, or a kind
  // (its first power). A site's "goods" (Karl, 2026-11-22: territory pays in goods only) are units an hour of each material it sends its holder's
  // nearest station that trades it (one over that planet, else the one most short of it), and that is all a site earns: a kind's "income" is no
  // longer paid. A power with no station (the Raiders) gets nothing from its sites; it lives on loot. The "far" numbers move, fight and set down the groups nobody sees (section 8).
  "format": "call-of-slop-npc-territory/1",
  "majority": 0.5,
  "kinds": {
    "spaceport": { "weight": 10, "garrison": 8, "income": 20 },
    "refinery": { "weight": 6, "garrison": 5, "income": 12 },
    "mine": { "weight": 4, "garrison": 3, "income": 8 },
    "outpost": { "weight": 3, "garrison": 4, "income": 3 }
  },
  "far": {
    "groupsPerTick": 8, "materialise": 5000, "collapse": 7000, "collapseSeconds": 60, "spawnFromPeople": 600,
    "groundSpeed": 12, "spaceSpeed": 3000, "transitSeconds": 600, "landSeconds": 90, "siteReach": 800,
    "fightRate": 0.01, "fightCap": 0.02, "takeSeconds": 120, "regenPerMinute": 0.1,
    "takeEveryMinutes": 3, "holdMinutes": 10, "gatherMinutes": 3, "takeShips": 3, "farGroups": 3
  },
  "planets": {
    "Glacier": [
      { "name": "Glacier Spaceport", "kind": "spaceport", "at": [20, 30], "holder": "Militia" },
      { "name": "Icefall Refinery", "kind": "refinery", "at": [-10, 80], "holder": "Militia", "goods": { "iron ore": 800, "ice": 500 } },
      { "name": "North Rime Mine", "kind": "mine", "at": [35, -40], "holder": "Traders", "goods": { "iron ore": 600, "ice": 500 } },
      { "name": "Crevasse Mine", "kind": "mine", "at": [5, 140], "holder": "Traders", "goods": { "copper ore": 300 } },
      { "name": "Drift Camp", "kind": "outpost", "at": [-40, -100], "holder": "Raiders" }
    ],
    "Rime": [ { "name": "Rime Mine", "kind": "mine", "at": [0, 0], "holder": "Militia", "goods": { "iron ore": 400 } } ],
    "Shard": [
      { "name": "Shard Mine 1", "kind": "mine", "at": [10, 10], "holder": "Raiders", "goods": { "gold ore": 60 } },
      { "name": "Shard Mine 2", "kind": "mine", "at": [-20, 60], "holder": "Raiders", "goods": { "iron ore": 300 } },
      { "name": "Shard Mine 3", "kind": "mine", "at": [40, -90], "holder": "Traders", "goods": { "gold ore": 60 } },
