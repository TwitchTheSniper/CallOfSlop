{
  // The Order of the Fold at the penal colony (docs/story/STORY.md "The Order of the Fold"; the faith is
  // Story/Factions/Fold.json). Side-plot beats (bucket B): the chaplain's sermon, the morning laminate (the Order's first
  // job), and Sister Wren of the Open Hand, who reads the same verses the other way. Faith and Doubt are left for the
  // fragments (the data centres) and the ending to read: what the player believes when they reach the machine.
  "format": "call-of-slop-storylets/1",
  "about": "the Order of the Fold's chaplain and laundress at the penal colony: the scripture, and the sect that doubts it",
  "qualities": [
    { "name": "Faith", "kind": "progress", "max": 5, "about": "how far a player has come into the Order of the Fold (sermons heard, laminates rolled)" },
    { "name": "Doubt", "kind": "progress", "max": 5, "about": "how far a player has listened to the Open Hand, who would unroll the fold" }
  ],
  "spots": [
    { "name": "Chapel Board", "near": "Chaplain Marlow", "reach": 4 }
  ],
  "storylets": [
    {
      "id": "sermon", "title": "The chaplain's sermon", "bucket": "B",
      "about": "the chaplain catches a new inmate by the bread and tells them how the five were saved",
      "needs": "?me Inducted, ?me Visited 'Chapel Board' >= 1",
      "cast": "?c MemberOf 'Order of the Fold', ?c is Person, not ?c Unroller, not ?c Grudge ?me >= 30",
      "beats": [
        { "by": "?c", "to": "?me", "say": [ "Bread, {me.first}? Take it. It's laminate. A thousand layers, and a world kept in every one." ] },
        { "by": "?c", "to": "?me", "after": "5s", "say": [ "In the first days a Hunger came to the edge of the board, and it would have eaten the five loaves whole." ] },
        { "by": "?c", "to": "?me", "after": "6s", "say": [ "So the Baker took up the Pin and rolled out from the centre, and the Hunger was rolled under. Blessed be." ] },
        { "by": "?c", "to": "?me", "after": "6s", "say": [ "And the sky went empty, but nothing was lost. All of it is kept in the dough. Let it rest." ] }
      ],
      "ends": [
        { "id": "heard", "after": "4s", "learn": "The Rolling", "from": "?c", "then": [ "?me Faith +1", "?c Likes ?me +5" ],
          "say": [ "Come to the board in the morning, if you like. We roll the laminate at first light." ], "next": "laminate" }
      ]
    },
    {
      "id": "laminate", "title": "The morning laminate", "bucket": "B", "priority": 1,
      "about": "the chaplain asks for layers for the Order's daily laminate (its first job)",
      "needs": "?me Faith >= 1, ?me Lead 'The Rolling'",
      "cast": "?c MemberOf 'Order of the Fold', ?c is Person, not ?c Unroller",
      "prefer": "?c Likes ?me",
      "beats": [
        { "by": "?c", "to": "?me", "say": [ "The morning laminate wants layers, {me.first}. Steel will do. The Ministry won't miss a few plates." ] }
      ],
      "job": "Order of the Fold: The Daily Laminate",
      "ends": [
        { "id": "rolled", "when": { "verb": "Job", "actor": "?me", "item": "The Daily Laminate" }, "within": "1h",
          "then": [ "?me Faith +1", "?c Likes ?me +10" ], "say": [ "Twenty-four layers. Twenty-four worlds kept. You have a kneader's hands." ], "next": "open-hand" },
        { "id": "unrolled", "after": "1h", "say": [ "No layers? Never mind. Dough is patient. So is the Order." ], "next": "open-hand" }
      ]
    },
    {
      "id": "open-hand", "title": "The Open Hand", "bucket": "B", "final": true,
      "about": "the laundress, quietly of the sect that would unroll the fold, asks the player what the verses really say",
      "needs": "?me Faith >= 1",
      "cast": "?w MemberOf 'Order of the Fold', ?w is Person, ?w Unroller",
      "beats": [
        { "by": "?w", "to": "?me", "say": [ "Heard the sermon, have you? Every star a layer folded under ours. Kept, he says." ] },
        { "by": "?w", "to": "?me", "after": "5s", "say": [ "Under, {me.first}. Pressed flat. Everyone out there, rolled under us so we could keep our bread." ] },
        { "by": "?w", "to": "?me", "after": "6s", "say": [ "There are a few of us. The Open Hand. We think the Pin should be turned back. Will you keep that to yourself?" ] }
      ],
      "ends": [
        { "id": "listened", "choice": "I'll keep it to myself.", "learn": "The Open Hand", "from": "?w", "then": [ "?me Doubt +1", "?w Likes ?me +15" ],
          "say": [ "Keep your hand open, {me.first}. The old records weren't lost. They were locked away." ] },
        { "id": "told", "choice": "The chaplain should hear this.", "then": [ "?me Faith +1", "?w Grudge ?me +20" ],
          "say": [ "Then tell him. He'll pray for me. He always does." ] },
        { "id": "shrugged", "after": "3m", "say": [ "Think about it. That's all I ask." ] }
      ]
    }
  ]
}
