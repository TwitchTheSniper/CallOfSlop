{
  // The penal colony after the warden's induction (docs/story/STORY.md "Storylets"). DRAFT beats from the storyline
  // talk (2026-11-09), there to try the format; Karl settles the content. One storylet at a time per player: an urgent
  // one first, then the A plot (Rank, the road) and the B plot (the colony's people) in turn.
  "format": "call-of-slop-storylets/1",
  "about": "the Ministry of Slop's penal colony: rank up, or get out",
  "qualities": [
    { "name": "Rank", "kind": "progress", "max": 5, "about": "how far up the colony's ladder a player is (inmate, trusty...)" },
    { "name": "Suspicion", "kind": "menace", "max": 10, "decay": "-1 per 30m", "about": "how closely the Ministry watches a player" },
    { "name": "Fixit", "kind": "progress", "max": 5, "about": "the duty desk's computer: 1 asked, 2 mended (a Mend), 3 thanked, 4 paid the scammers, 5 told off (Game/GameColonyPc.cs)" },
    { "name": "Nag", "kind": "menace", "max": 2, "decay": "-1 per 10m", "about": "the duty desk wants its rotas: while it lasts nobody else brings the computer up" }
  ],
  "spots": [
    { "name": "Kettle", "near": "Officer Crumb", "reach": 5 }
  ],
  "storylets": [
    {
      "id": "work-detail", "title": "Work detail", "bucket": "A",
      "about": "a guard sets the first work detail and inspects it",
      "needs": "?me Inducted",
      "cast": "?n MemberOf 'Ministry of Slop', ?n is Person, not ?n Grudge ?me >= 40",
      "beats": [
        { "by": "?n", "to": "?me", "say": [ "Inmate {me.first}. Work detail. The Ministry wants rocks broken, and you have hands." ] },
        { "by": "?n", "to": "?me", "after": "4s", "say": [ "Fill a Requisition Crate. I'll be inspecting. With a clipboard." ] }
      ],
      "job": "Ministry of Slop: Breaking Rocks",
      "ends": [
        { "id": "done", "when": { "verb": "Job", "actor": "?me", "item": "Breaking Rocks" }, "within": "45m",
          "then": [ "?me Rank +1", "?n Likes ?me +10" ], "say": [ "Signed off. In triplicate. Well done, {me.first}." ], "next": "bellweathers-test" },
        { "id": "botched", "after": "45m",
          "then": [ "?me Suspicion +1" ], "say": [ "No rocks, {me.first}? That's going on your file." ] }
      ]
    },
    {
      "id": "tea-with-crumb", "title": "Tea with Crumb", "bucket": "B",
      "about": "the gossipy guard by the kettle lets slip a way out",
      "needs": "?me Inducted, ?me Visited 'Kettle' >= 2",
      "cast": "?c MemberOf 'Ministry of Slop', ?c is Person, ?c Gossipy >= 60",
      "prefer": "?c Gossipy",
      "beats": [
        { "by": "?c", "to": "?me", "say": [ "You again. Kettle's on. Don't tell the Sergeant." ] },
        { "by": "?c", "to": "?me", "after": "5s", "say": [ "Between us, the old mine past the fence? Nobody's checked it since the cave-in." ] }
      ],
      "ends": [
        { "id": "told", "after": "3s", "learn": "Old Mine", "from": "?c", "then": [ "?c Likes ?me +5" ],
          "say": [ "You didn't hear that from me. You didn't hear anything." ], "next": "wardens-offer" }
      ]
    },
    {
      "id": "bellweathers-test", "title": "Bellweather's test", "bucket": "A",
      "about": "the sergeant leaves a crate unwatched to see what the player does",
      "needs": "?me Rank >= 1",
      "cast": "?s MemberOf 'Ministry of Slop', ?s is Person, ?s Brave >= 60",
      "prefer": "?s Brave",
      "beats": [
        { "by": "?s", "to": "?me", "say": [ "Watch this crate for me, {me.first}. I'll be back. Probably." ] }
      ],
      "ends": [
        { "id": "taken", "when": { "verb": "Pilfer", "actor": "?me" }, "within": "10m",
          "then": [ "?me Suspicion +2" ], "say": [ "Light fingers, {me.first}. I'll remember that." ] },
        { "id": "left", "after": "10m",
          "then": [ "?me Rank +1", "?s Likes ?me +15" ], "say": [ "All there. Hm. Maybe you're not the worst of them." ], "next": "wardens-offer" }
      ]
    },
    {
      "id": "shakedown", "title": "Shakedown", "bucket": "urgent", "again": "1h",
      "about": "the guards search a player they suspect",
      "needs": "?me Suspicion >= 3",
      "cast": "?g MemberOf 'Ministry of Slop', ?g is Person",
      "prefer": "?g Likes ?me",
      "beats": [
        { "by": "?g", "to": "?me", "say": [ "Hands where I can see them, {me.first}. Routine search." ] }
      ],
      "ends": [
        { "id": "covered", "after": "8s", "if": "?me Contraband, ?g Likes ?me >= 40",
          "then": [ "?me Contraband =0", "?me Suspicion -1" ], "say": [ "...Nothing here. Put that away before someone else sees it." ] },
        { "id": "caught", "after": "8s", "if": "?me Contraband", "hook": "lockdown",
          "then": [ "?me Contraband =0", "?me Suspicion +2" ], "say": [ "What's this, then? GUARDS!" ] },
        { "id": "clean", "after": "8s",
          "then": [ "?me Suspicion -2" ], "say": [ "Clean. This time." ] }
      ]
    },
    {
      "id": "wardens-offer", "title": "The Warden's offer", "bucket": "A",
      "about": "the warden offers a place in the Ministry; the player who knows a way out may turn it down",
      "needs": [ "?me Rank >= 2, not ?me Course ?r", "?me Suspicion >= 3, ?me Lead 'Old Mine', not ?me Course ?r" ],
      "cast": "?w is Person, ?w == 'Warden Pettigrew'",
      "beats": [
        { "by": "?w", "to": "?me", "say": [ "{me.first}. Sit. The Ministry has a vacancy, and you have, against all odds, a record." ] },
        { "by": "?w", "to": "?me", "after": "5s", "say": [ "Trustee. Better rations, a badge. Well?" ] }
      ],
      "ends": [
        { "id": "trustee", "choice": "I'll serve the Ministry.", "then": [ "?me Course 'Trustee'", "?me Rank +1" ],
          "say": [ "Splendid. Forms are on the desk. All of them." ], "next": "first-posting" },
        { "id": "escapee", "choice": "I'd rather not.", "if": "?me Lead 'Old Mine'", "then": [ "?me Course 'Escapee'", "?me Suspicion +1" ],
          "say": [ "Pity. We'll be watching you, {me.first}." ], "next": "old-mine" },
        { "id": "later", "after": "10m", "say": [ "Think it over. The offer stands. Probably." ] }
      ]
    },
    {
      "id": "first-posting", "title": "First posting", "bucket": "A",
      "about": "the new trustee is posted to the Orbital Depot (the robot shell beat); the Ministry ladder goes on in Storylets/Ministry.json",
      "needs": "?me Course 'Trustee'",
      "hook": "depot",
      "ends": [
        { "id": "posted", "after": "5s", "then": [ "?me Rank +1" ],
          "say": [ "[MINISTRY MEMO] Trustee posting: Orbital Depot. Report to the control chair." ], "next": "stores-key" }
      ]
    },
    {
      "id": "old-mine", "title": "The old mine", "bucket": "A", "final": true,
      "about": "the would-be escapee slips off to the old mine",
      "needs": "?me Course 'Escapee', ?me Lead 'Old Mine'",
      "cast": "?c MemberOf 'Ministry of Slop', ?c is Person, ?c Likes ?me >= 20",
      "prefer": "?c Likes ?me",
      "beats": [
        { "by": "?c", "to": "?me", "say": [ "If you're going, go at the shift change. I'll be at the kettle. Facing the other way." ] }
      ],
      "ends": [
        { "id": "tipped", "after": "3s", "then": [ "?c Likes ?me +5" ] }
      ]
    },
    // ---- The duty desk's computer (Game/GameColonyPc.cs; Karl, 2026-11-14): the barracks' computer has Tech Support's
    //      virus. Nobody says how to mend it. It has no switch; it runs off the barracks' Battery, and cutting its power
    //      is the cure (take the battery off with the attach tool, fit it back). Paying the scammers also cures it.
    {
      "id": "duty-desk", "title": "The duty desk", "bucket": "B",
      "about": "the guard at the duty desk can't get the rotas off the computer: it says it has a virus",
      "needs": "?me Inducted, not ?me Fixit",
      "cast": "?d MemberOf 'Ministry of Slop', ?d is Person, not ?d Grudge ?me >= 40",
      "prefer": "?d Honest",
      "beats": [
        { "by": "?d", "to": "?me", "say": [ "Inmate {me.first}. You look like you've touched a computer. Don't answer that." ] },
        { "by": "?d", "to": "?me", "after": "4s", "say": [ "The duty desk machine says it has four thousand viruses. And not to turn it off. So nobody has." ] },
        { "by": "?d", "to": "?me", "after": "5s", "say": [ "I need the rotas off it by Thursday. Have a look. Don't touch anything." ] }
      ],
      "ends": [
        { "id": "asked", "after": "2s", "then": [ "?me Fixit =1", "?me Nag =2" ], "hook": "pcvirus",
          "world": [ "The barracks' computer turns red with Tech Support's pop-ups, and writes to whoever stands at it." ],
          "next": "duty-desk-mended" }
      ]
    },
    {
      "id": "duty-desk-again", "title": "Off and on again", "bucket": "B",
      "about": "a gossip at the barracks says what IT always says, and that the machine hasn't got a switch",
      "needs": "?me Fixit >= 1, ?me Fixit < 2, not ?me Nag",
      "cast": "?c MemberOf 'Ministry of Slop', ?c is Person, not ?c Grudge ?me >= 40",
      "prefer": "?c Gossipy",
      "beats": [
        { "by": "?c", "to": "?me", "say": [ "That machine at the duty desk is still at it. Nobody goes near it now." ] },
        { "by": "?c", "to": "?me", "after": "4s", "say": [ "IT faxed once. Their answer to everything is off and on again. That thing hasn't got a switch." ] },
        { "by": "?c", "to": "?me", "after": "5s", "say": [ "Nothing in the barracks has. The lights go off when the box on the wall says so." ] }
      ],
      "ends": [
        { "id": "hinted", "after": "3s", "then": [ "?c Likes ?me +2" ], "next": "duty-desk-mended" }
      ]
    },
    {
      "id": "duty-desk-mended", "title": "Rotas by Thursday", "bucket": "B", "final": true, "priority": 2,
      "about": "the computer came back clean, and the duty desk noticed",
      "needs": "?me Fixit >= 2, ?me Fixit < 3",
      "cast": "?d MemberOf 'Ministry of Slop', ?d is Person, not ?d Grudge ?me >= 40",
      "prefer": "?d Honest",
      "beats": [
        { "by": "?d", "to": "?me", "say": [ "The duty desk machine came up clean. No viruses. Was that you, {me.first}?" ] },
        { "by": "?d", "to": "?me", "after": "4s", "say": [ "Don't tell me how. If it's in the handbook I'd rather not know which page." ] }
      ],
      "ends": [
        { "id": "thanked", "after": "3s", "then": [ "?me Fixit =3", "?d Likes ?me +10", "?me Suspicion -1" ],
          "say": [ "Rotas are printing. I'll put a word in. A small one." ] }
      ]
    },
    {
      "id": "duty-desk-paid", "title": "Battery's code", "bucket": "B", "final": true, "priority": 2,
      "about": "the pop-ups are gone, and so is most of the barracks' battery",
      "needs": "?me Fixit >= 4, ?me Fixit < 5",
      "cast": "?d MemberOf 'Ministry of Slop', ?d is Person",
      "prefer": "?d Honest",
      "beats": [
        { "by": "?d", "to": "?me", "say": [ "The machine's quiet. The barracks battery is nearly flat. Somebody gave Tech Support a number." ] },
        { "by": "?d", "to": "?me", "after": "4s", "say": [ "I'm not asking who. I'm writing it down, though." ] }
      ],
      "ends": [
        { "id": "noted", "after": "3s", "then": [ "?me Fixit =5", "?me Suspicion +1" ] }
      ]
    }
  ]
}
