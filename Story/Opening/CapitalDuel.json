  "format": "call-of-slop-opening/1",
  "cast": "",
  "warden": "",
  "wreck": "",
  "ship": "Mainframe", // the blueprint everyone wakes aboard (Source/PartKit/Generators/MainframeParts*.cs)
  "orbit": 100000, // m over the ground (at most 150 km: inside the World's 200 km reach from the planet's centre with the company)
  "hold": true,
  // Where people wake, one each in turn, standing, in the ship's own metres from its first part's middle: on the bridge (its
