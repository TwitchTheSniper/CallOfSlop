{
  // The survival opening (docs/story/OPENING.md; Game/GameSandboxOpening.cs): what a new survival world's players go
  // through on arriving. Times are seconds. Text is ASCII. The lines are the warden's ("by": "warden") at "at" seconds
  // into their beat, to everyone in that group (co-op: friends who arrive together wake together). "group": true says a
  // line only when more than one arrived together.
  "format": "call-of-slop-opening/1",
  "colony": "Penal Colony", // the blueprint everyone wakes in (its cell block), with the cast below living there
  "cast": "Penal Colony", // Story/Casts
  "warden": "Warden Pettigrew", // the cast's person who says the wake line (and runs the induction)
  "wreck": "Crashed Plane", // the blueprint left out past the colony (a wreck, salvageable)
  "crashFrom": 70, "crashTo": 140, // m from the colony's middle: where the wreck goes
  "beats": {
    // A placeholder for the crash landing (Karl, 2026-11-12: the falling-down-in-your-ship scene is to be made again):
    // black, this caption, already in the cell block; then waking.
    "placeholder": { "time": 4.0, "caption": "Your ship comes down hard. The Ministry of Slop finds you." },
    "wake": { "time": 4.5, "lines": [
      { "at": 1.5, "by": "warden", "text": "On your feet, convict. Welcome to the colony." }
    ] }
  },
  "skip": "skip the opening" // (shown after the jump key's name)
}
