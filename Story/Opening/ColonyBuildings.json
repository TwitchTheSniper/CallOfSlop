{
  // The Ministry of Slop's buildings round the penal colony (docs/story/OPENING.md "The Ministry's buildings";
  // Game/GameColonyBuildings.cs). Built with the colony on a fresh story world, in this order. "at" is where a building's
  // middle stands in the colony's own frame, in metres: x along the colony's front (its gate is at x 6), z back from it
  // (the gate at z 0, the yard from z 0 to 12, so negative z is out in front). "yaw" turns it (degrees; 180 faces its
  // door back towards the colony). "level": how much the ground under it may vary (m, default 1.2). When its spot is
  // taken or too steep it goes on the nearest clear, level spot within "slack" metres, or isn't built.
  "format": "call-of-slop-colony-buildings/1",
  "slack": 12,
  "buildings": [
    // The gatehouse by the gate, on the east side, its step to the street and its roof thrown out towards the gate.
    { "blueprint": "Colony Gatehouse", "at": [13, -5.75], "yaw": 0 },
    // Across the street (z -10.5 to -15), facing the colony, their fronts in a line at about z -15 (the gatehouse's step comes out to z -10.5): the infirmary, the records office
    // with its queue under the overhang, the canteen (the tall one, its kitchen and stack behind) and the stores' dock.
    { "blueprint": "Colony Infirmary", "at": [-9, -20], "yaw": 180 },
    { "blueprint": "Ministry Records Office", "at": [2, -22], "yaw": 180 },
    { "blueprint": "Colony Canteen", "at": [14.5, -22.5], "yaw": 180 },
    { "blueprint": "Requisitions Store", "at": [26, -20.5], "yaw": 180 },
    // Lamps along the street's north kerb, for the dark and the weather (off the carriageway: the site's slabs lie at z -14.9 to -10.9).
    { "blueprint": "Lamp Post", "at": [-11, -9.8] },
    { "blueprint": "Lamp Post", "at": [21, -9.8] },
    { "blueprint": "Lamp Post", "at": [29, -9.8] },
    // Watchtowers off the yard's back corners.
    { "blueprint": "Watchtower", "at": [-4, 15] },
    { "blueprint": "Watchtower", "at": [16, 15] },

    // ---- The site (Game/GameColonySite.cs; docs/sandbox/constructs/buildings.md "The site") --------------------------
    // "elsewhere": a building another file builds, stood here when the colony has its bench (else it looks for level
    // ground as before). The guards' barracks west of the yard, its door (east) to the muster square; the Remote Works
    // east of it, behind the gatehouse.
    { "blueprint": "Colony Barracks", "at": [-10.5, 4.5], "elsewhere": true },
    { "blueprint": "Remote Works", "at": [36, 8], "elsewhere": true },
    // "site": laid at exactly this spot in the colony's plane, "sink" m into the bench; only on a fresh world's bench.
    // The boiler house at the street's east end, set back behind a coal forecourt, its stack at the head of the mains.
    { "blueprint": "Colony Boiler House", "at": [37, -26.2], "yaw": 180, "site": true },
    // The street: slabs from x -16 to 32, and the way from it to the yard's gate under the covered way.
    { "blueprint": "Colony Road 24 m", "at": [-4, -12.9], "site": true, "sink": 0.13 },
    { "blueprint": "Colony Road 24 m", "at": [20, -12.9], "site": true, "sink": 0.13 },
    { "blueprint": "Colony Gate Path", "at": [5.875, -5.6], "site": true, "sink": 0.13 },
    // The muster square west of the gate path, in front of the barracks: the flag and the notices.
    { "blueprint": "Colony Muster Square", "at": [-2.125, -6.725], "site": true, "sink": 0.13 },
    // The heating mains: from the boiler house west behind the street's buildings, north up the west side, over the
    // street on the portal and on to the barracks. A valve chamber at each end and at the corner.
    { "blueprint": "Heating Valve Chamber", "at": [34.75, -31.4], "site": true },
    { "blueprint": "Heating Main 24 m", "at": [22, -31.4], "site": true },
    { "blueprint": "Heating Main 24 m", "at": [-2, -31.4], "site": true },
    { "blueprint": "Heating Valve Chamber", "at": [-14.75, -31.4], "site": true },
    { "blueprint": "Heating Main 12 m", "at": [-14.75, -24.65], "yaw": 90, "site": true },
    { "blueprint": "Heating Main 2 m", "at": [-14.75, -17.65], "yaw": 90, "site": true },
    { "blueprint": "Heating Main Portal", "at": [-14.75, -12.15], "yaw": 90, "site": true },
    { "blueprint": "Heating Main 12 m", "at": [-14.75, -1.65], "yaw": 90, "site": true },
    { "blueprint": "Heating Valve Chamber", "at": [-14.75, 5.1], "site": true },
    // The way in from the east: a pier each side of the road at the top of the ramp.
    { "blueprint": "Colony Gate Pier", "at": [44, -8.5], "yaw": 270, "site": true },
    { "blueprint": "Colony Gate Pier", "at": [44, -15.5], "yaw": 270, "site": true },
    // The branches: from the mains behind the street (their pipes' near side at z -30.95) to each building's back wall.
    { "blueprint": "Heating Branch 6.5 m", "at": [-10, -27.7], "yaw": 90, "site": true },
    { "blueprint": "Heating Branch 3 m", "at": [2, -29.45], "yaw": 90, "site": true },
    { "blueprint": "Heating Branch 2 m", "at": [14, -29.95], "yaw": 90, "site": true },
    { "blueprint": "Heating Branch 6 m", "at": [26, -27.95], "yaw": 90, "site": true },
    // The outer fence: precast panels round the bench, x -20 to 44 and z -36 to 20, 2 m inside its edge. Two ways through
    // it, both across the street's ends (z -16 to -8): the main gate in the east side between the piers, its leaves slid
    // open along the inside of the fence, and the service gate in the west side, shut.
    { "blueprint": "Colony Fence 24 m", "at": [-8, 20], "site": true },
    { "blueprint": "Colony Fence 24 m", "at": [16, 20], "site": true },
    { "blueprint": "Colony Fence 16 m", "at": [36, 20], "site": true },
    { "blueprint": "Colony Fence 24 m", "at": [-8, -36], "site": true },
    { "blueprint": "Colony Fence 24 m", "at": [16, -36], "site": true },
    { "blueprint": "Colony Fence 16 m", "at": [36, -36], "site": true },
    { "blueprint": "Colony Fence 20 m", "at": [-20, -26], "yaw": 90, "site": true },
    { "blueprint": "Colony Fence 28 m", "at": [-20, 6], "yaw": 90, "site": true },
    { "blueprint": "Colony Fence 20 m", "at": [44, -26], "yaw": 90, "site": true },
    { "blueprint": "Colony Fence 28 m", "at": [44, 6], "yaw": 90, "site": true },
    { "blueprint": "Colony Sliding Gate", "at": [-20, -12], "yaw": 90, "site": true },
    { "blueprint": "Colony Sliding Gate", "at": [43.5, -3.9], "yaw": 90, "site": true }
  ],
  // The bench: the ground under the whole site, graded level to the colony's own height on a fresh world ("most": not
  // when the land stands further than this over or under it), and the ramps from its edge down to the land (the street's
  // two ends).
  "bench": {
    "min": [-22, -38], "max": [46, 24], "most": 6,
    // The works yard: where a survival world's starter machines and rigs stand, inside the fence (between the gatehouse and
    // the Remote Works, then behind the yard between the watchtowers).
    "kit": [
      { "min": [18.5, -0.5], "max": [29.5, 19.5] },
      { "min": [-1.5, 12.6], "max": [13.5, 19.5] },
      { "min": [-19.5, 9.5], "max": [-7, 19.5] }
    ],
    "ramps": [
      { "from": [-21, -12.9], "to": [-40, -12.9] },
      { "from": [45, -12.9], "to": [64, -12.9] }
    ]
  }
}
