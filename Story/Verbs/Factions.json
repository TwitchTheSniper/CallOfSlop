{
  // Factions (docs/story/STORY.md "Factions"): what players do with a faction's channels, and what a faction does back.
  "verbs": [
    { "name": "Email", "players": true, "sentence": "{actor} emailed {target}",
      "about": "a player at a plugged-in Computer types to a faction (target: the faction); its deeds can read the words", "effects": [ "target Emails actor +1" ] },
    { "name": "Fax", "sentence": "{actor} faxed {target}",
      "about": "a faction's page prints on a fax near a player (actor: the faction, target: the reader's group)", "effects": [ "actor Faxed target +1" ] },
    { "name": "Keep", "players": true, "sentence": "{actor} plugged in {target}'s {item}",
      "about": "a faction's hardware on a player's circuit: its first page prints (target: the faction, item: the part)" },
    { "name": "Atrocity", "sentence": "{actor} committed an atrocity at {place}",
      "about": "something no faction forgives (later: an antimatter bomb dropped on a town or colony); the doer and their group are Notorious, hunted by every faction", "effects": [ "actor Notorious +1" ] },
    { "name": "Unite", "players": true, "sentence": "{actor} founded {target}",
      "about": "a player founds a player faction (target: its group, a Faction entity)" },
    { "name": "Ally", "sentence": "{actor} and {target} are allies",
      "about": "two player factions both want an alliance (actor, target: their groups)" },
    { "name": "Feud", "sentence": "{actor} went to war with {target}",
      "about": "a player faction declares war on another (actor, target: their groups)", "effects": [ "target Grudge actor +20" ] },
    { "name": "Truce", "sentence": "{actor} and {target} are neither friends nor enemies any more",
      "about": "two player factions' alliance or war ends (actor, target: their groups)" },
    { "name": "Rate", "sentence": "{actor} now rates {target}: {item}",
      "about": "a faction's standing with a group comes to a new tier (item: the tier, value: the standing)" }
  ]
}
