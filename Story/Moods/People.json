{
  // The people's moods in a fight (docs/story/STORY.md "Moods"): buffs and debuffs a person's body takes on at a moment
  // and keeps for "seconds". Moments: Killed (someone was killed within 30 m of them: ?them the killer, ?target the dead),
  // Kill (they killed ?target), Hurt (?them hurt them), Wounded (hurt below a third of their health, once a fight) and
  // Defend (they came to help ?target against ?them). Of a moment's moods whose "if" holds (a query over ?me ?them
  // ?target ?here), the one with the most clauses wins; "chance" makes it take hold only so often. One mood at a time:
  // a new one takes over only from one of the same or a lower "rank" (0-9).
  // While it lasts: "taken" and "dealt" multiply the damage they take and deal, "aim" their aim error (above 1 is
  // worse), "react" their reaction time and trigger delay (below 1 is quicker), "turn" how fast they turn. "act": "fight"
  // makes them fight ?them whatever they would have done (and they don't lose their nerve), "flee" makes them run from
  // ?them. "verb" is recorded as it takes hold (actor ?me, target ?them, owner ?target), "then" is the mood after it.
  // The game says the mood's name as an occasion (Story/Lines), and players nearby see its "label" in the chat.
  "about": "rage, vengeance, panic, grief and the rest: how a killing or a wound changes how the people fight",
  "moods": [
    { "name": "Rage", "label": "flies into a murderous rage", "on": "Killed", "if": "?me Likes ?target >= 20",
      "about": "someone they like killed in front of them: they go for the killer, hard to stop and shooting wild",
      "rank": 8, "seconds": 60, "taken": 0.6, "dealt": 1.15, "aim": 2.5, "react": 0.6, "turn": 1.3,
      "act": "fight", "verb": "Rage", "then": "Grief" },
    { "name": "Vengeance", "label": "goes cold and quiet", "on": "Killed", "if": "?me Likes ?target >= 20, ?me Vengeful >= 70, ?me Brave >= 30",
      "about": "the vengeful kind: no shouting, a steady hand and every shot meant",
      "rank": 8, "seconds": 90, "taken": 0.85, "dealt": 1.25, "aim": 0.6, "react": 0.8,
      "act": "fight", "verb": "Vow", "then": "Grief" },
    { "name": "Panic", "label": "panics", "on": "Killed", "if": "?me Likes ?target >= 20, ?me Brave < 30",
      "about": "the timid kind: they bolt, and if cornered can barely hold a gun straight",
      "rank": 7, "seconds": 30, "aim": 2.2, "react": 1.6, "turn": 0.8, "act": "flee", "verb": "Panic", "then": "Grief" },
    { "name": "Shaken", "label": "is shaken", "on": "Killed", "if": "?me Likes ?target < 20, ?me Brave < 50",
      "about": "a killing nearby, of someone they hardly knew: their hands shake for a while",
      "rank": 3, "seconds": 25, "aim": 1.6, "react": 1.4 },
    { "name": "Grief", "label": "is grieving", "about": "after the rage, the panic or the vow: slow and unsteady for a couple of minutes",
      "rank": 2, "seconds": 120, "aim": 1.5, "react": 1.5, "turn": 0.75 },
    { "name": "Desperate", "label": "fights like a cornered animal", "on": "Wounded", "if": "?me Brave >= 60",
      "about": "badly hurt and too brave to run: they shrug off hits and won't back down",
      "rank": 6, "seconds": 30, "taken": 0.7, "aim": 1.3, "act": "fight" },
    { "name": "Protective", "label": "stands over them", "on": "Defend", "if": "?me Likes ?target >= 40",
      "about": "coming to help someone they really care for",
      "rank": 4, "seconds": 30, "taken": 0.8, "dealt": 1.1 },
    { "name": "Bloodlust", "label": "is out for blood", "on": "Kill", "if": "?me Vengeful >= 60, ?target is Player",
      "about": "the vengeful, having killed a player: sharper and hungrier for a little while",
      "rank": 5, "seconds": 30, "dealt": 1.2, "aim": 0.8, "react": 0.8 }
  ]
}
