  ],
  "teaches": [
    { "name": "The Weight of the Centre", "tier": "Proved",
      "about": "the Order's teaching that all things are drawn to the centre the dough was rolled from: gravity, made by hand",
      "parts": [ "Gravity Generator", "Gravity Well" ] },
    { "name": "The Lesser Fold", "tier": "Laminated",
      "about": "a small fold of the dough, held for a moment: the Jump Drive. The Order teaches it as a prayer, and will not say where it learnt it",
      "parts": [ "Jump Drive" ] },
    { "name": "The Rising", "tier": "Of the Thousand Layers",
      "about": "dough that rests will rise: the Order's anti-gravity, taught only to those who will never unroll it",
      "parts": [ "Anti-Grav Generator", "Medium Anti-Grav Generator", "Large Anti-Grav Generator", "Capital Anti-Grav Generator" ] }
  ],
  "rivals": { "Ministry of Slop": 20 },
  "voice": "THE ORDER",
  "courier": "Two novices in floured aprons carry the crate away between them, singing the verse of the Resting under their breath.",
  "scripture": [
    { "name": "The Hunger", "fragment": "threat",
      "text": "In the first days a Hunger came to the edge of the board, and it would have eaten the five loaves whole. And the people of the five were afraid, for nothing they had could feed it or turn it away.",
      "bends": "the threat was a physical thing local to the five systems; the verse makes it a beast with an appetite, and forgets that it was folded in with them and is still there" },
    { "name": "The Rolling", "fragment": "fold",
      "text": "Then the Baker laid the five loaves on the board and took up the Pin, and rolled out from the centre, and the Hunger was rolled under, between the layers, where it cannot rise.",
      "bends": "many builders of the five systems banded together, each solving a part; the verse gives it to one Baker and a deliberate holy act, not an accident of good intentions" },
    { "name": "The Thousand Layers", "fragment": "instruments",
      "text": "The watchers looked up and the sky beyond the five was empty, and the Baker said: weep not. Every star is a layer folded under ours. Nothing is lost. All of it is kept in the dough.",
      "bends": "the instruments showed the fold run out to infinity and the rest of the universe gone; the verse turns that loss into a comfort (the Open Hand reads it the other way: the stars are under us, crushed, and owed the light)" },
    { "name": "The Resting", "fragment": "undone",
      "text": "And the Baker said: dough that is worked again grows tough and tears. Let it rest. Let no hand unroll what the Pin has rolled. Then the Baker laid down the Pin and went into the oven, and was not seen again.",
      "bends": "the builders chose not to undo it and erased what they knew (guilt, fear, maybe a war); the verse makes their silence a commandment and their disappearance an ascension" },
    { "name": "The Pin", "fragment": "machine",
      "text": "The Pin lies in five pieces, one in the deep of each world, and its handles are holy. Touch them not: the hand that turns the Pin back lets the Hunger rise and the five are eaten.",
      "bends": "the machine is real and can be switched off; the verse tells the true cost (the planets fall to the threat) and hides the rest (the universe comes back), and says nothing of a delay" }
  ],
  "jobs": [
