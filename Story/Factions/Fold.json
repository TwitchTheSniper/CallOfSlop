{
  // The Order of the Fold (docs/story/STORY.md "The Order of the Fold"): the faith that grew out of the story of the fold
  // (the storyline: the builders folded the five systems away from a threat, and the fold rolled out to infinity). Over
  // the generations the story was retold until it became scripture: each verse below bends one of the five fragments the
  // player can find (threat, fold, instruments, undone, machine; "bends" says how, for writers only). The faith is
  // serious; its sacrament is laminated dough, a thousand layers, each layer a world rolled out under ours. Most believers
  // want the fold kept for ever; the Open Hand, a sect inside it, reads the same verses and wants it unrolled. Its people
  // in the world are the penal colony's chaplain and laundress (Story/Casts/PenalColony.json); its storylets are
  // Story/Storylets/Fold.json.
  "format": "call-of-slop-faction/1",
  "name": "Order of the Fold",
  "about": "the faith of the Rolling: the five worlds were rolled out from the centre to keep them safe, and must be left to rest",
  "home": "The Bakehouse",
  "staff": [ "Chaplain Marlow", "Sister Wren" ],
  "members": [
    { "name": "Rolling Mother Agathe", "about": "head of the Order; has kneaded the same dough every morning for sixty years and calls it one loaf",
      "qualities": { "Sociable": 55, "Honest": 70, "Brave": 45, "Vengeful": 35, "Gossipy": 20, "Greedy": 15 } },
    { "name": "Deacon Hollis", "about": "keeper of the Bakehouse ovens; believes every word, and has read none of the old records",
      "qualities": { "Sociable": 45, "Honest": 80, "Brave": 60, "Vengeful": 55, "Gossipy": 30, "Greedy": 20 } },
    { "name": "Brother Anselm", "about": "copies the scripture by hand and keeps finding the old copies say something else",
      "qualities": { "Sociable": 30, "Honest": 90, "Brave": 25, "Vengeful": 15, "Gossipy": 40, "Greedy": 10 } },
    { "name": "Elder Coyle of the Open Hand", "about": "leads the sect that would unroll the dough; preaches in whispers, owes the Order nothing",
      "qualities": { "Sociable": 40, "Honest": 75, "Brave": 80, "Vengeful": 50, "Gossipy": 35, "Greedy": 10, "Unroller": 1 } }
  ],
  "wants": [
    { "name": "Devotion", "about": "faction want: how full the Bakehouse is on a rolling day, from 0 (empty) to 100", "start": 60, "perHour": -1 },
    { "name": "Stillness", "about": "faction want: how undisturbed the fold feels to the Order, from 0 (the Hunger stirs) to 100 (the dough rests)", "start": 80 }
  ],
  "tiers": [
    { "name": "Burnt Offering", "below": -50 },
    { "name": "Unleavened", "below": -15 },
    { "name": "Seeker", "below": 15 },
