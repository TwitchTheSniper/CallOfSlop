{
  // What goes out on the radio (docs/story/STORY.md "Lines"): a radio operator's Broadcast is said on the Radio occasion,
  // with ?actor and ?target who did what to whom, ?place where and ?here the station. Every player in the world hears it,
  // and everyone in a place in the story learns it.
  "about": "the radio's news",
  "rules": [
    { "on": "Radio", "say": [ "This is {here} radio. {news}.", "{here} radio with the news: {news}.", "News from {here}: {news}." ] },
    { "on": "Radio", "about": "Kill", "say": [ "This is {me.first} at {here}. {news}. Stay safe out there.", "{here} radio. Sad news: {news}. Look after each other." ] },
    { "on": "Radio", "about": "Kill", "if": "?me Likes ?target >= 20", "say": [ "{here} radio. {news}. I knew {target.first}. Everyone did.", "This is {me.first}. {target} is dead. {actor} did it. That's all I can say." ] },
    { "on": "Radio", "about": "Kill", "if": "?actor is Player", "say": [ "{here} radio. {news}. If you see {actor}, keep your distance." ] },
    { "on": "Radio", "about": "Steal", "say": [ "{here} radio. Word is {actor} has been helping themselves to other people's money. Lock your boxes." ] },
    { "on": "Radio", "about": "Wreck", "say": [ "Traffic from {here}: {news}. Drive carefully, people." ] },
    { "on": "Radio", "about": "Launch", "say": [ "{here} radio. {news}. Safe flying." ] },
    { "on": "Radio", "about": "Land", "say": [ "{here} radio. {news}. Welcome back." ] },
    { "on": "Radio", "about": "Jump", "say": [ "{here} radio. {news}. Further than any of us have been." ] },
    { "on": "Radio", "about": "Discover", "say": [ "{here} radio. Big news: {news}." ] },
    { "on": "Radio", "about": "Insult", "say": [ "{here} radio, and in local news: {news}. Again." ] },
    { "on": "Radio", "about": "Give", "say": [ "{here} radio. Some good news for once: {news}." ] },
    { "on": "Radio", "about": "Unite", "say": [ "{here} radio. There's a new outfit about: {news}. Be nice to them, or don't.", "News from {here}: {news}. Another lot with a flag." ] },
    { "on": "Radio", "about": "Ally", "say": [ "{here} radio. {news}. Mind how you go near either of them." ] },
    { "on": "Radio", "about": "Feud", "say": [ "{here} radio, and it's bad: {news}. Keep your heads down." ] },
    { "on": "Radio", "about": "Truce", "say": [ "{here} radio. {news}. For now." ] },
    { "on": "Radio", "about": "Teach", "say": [ "{here} radio. {news}. Somebody's moving up in the world.", "News from {here}: {news}. Make of that what you will." ] },
    { "on": "Radio", "about": "Hooked", "say": [ "{here} radio, consumer corner: {news}. Never answer the adverts, people." ] },
    { "on": "Radio", "about": "Atrocity", "say": [ "This is {here} radio. {news}. If you see {actor}, run. Every faction out there is after them now.", "{here} radio. There's no good way to say it: {news}." ] },
    { "on": "Radio", "about": "Turn", "say": [ "{here} radio, on how things stand: {news}.", "News from around: {news}. Plan your trips accordingly." ] },
    { "on": "Radio", "about": "Turn", "if": "?place Lawless", "say": [ "{here} radio. {news}. Stay away from {place} if you can." ] }
  ]
}
