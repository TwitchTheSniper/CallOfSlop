{
  // What the Ministry of Slop's people say when a player talks to them in the penal colony (docs/story/STORY.md "Talking to
  // people"). Hello is answered "Greeted" the first time and "Chatted" after; "Any news?" falls back on "NoNews"; the three
  // asks "What's this place?", "What do you do here?" and "Any advice?" are "AskPlace", "AskSelf" and "AskAdvice";
  // "Bye" is goodbye. A rule for one person (?me == 'Name', ?me is Person) beats one for the Ministry in general, which
  // beats the anyone-rules in Talk.json and People.json; a "once" rule is the person's own story, told one piece at a time
  // as the player keeps coming back. By the book, underpaid, and very fond of forms. Words change nothing.
  "about": "the Ministry of Slop's staff answering a player in the penal colony",
  "rules": [
    // ---- Hello, first time ----
    { "on": "Greeted", "if": "?me == 'Warden Pettigrew', ?me is Person",
      "say": [ "Ah. Good day. Warden Pettigrew. And you are? ...Yes, it's on the form. Do read the handbook.",
               "Hello, hello. The new intake. Warden Pettigrew. Name? ...Splendid. Mind the paperwork, it bites.",
               "How do you do. Warden Pettigrew. Welcome to the Ministry's penal colony. We do apologise for everything." ] },
    { "on": "Greeted", "if": "?me == 'Sergeant Bellweather', ?me is Person",
      "say": [ "Sergeant Bellweather. Name? ...I'll remember it. I've seen every escape attempt twice. Don't be a third.",
               "Hello. Bellweather. Sergeant. And you'd be? ...Right. Keep your nose clean and your boots cleaner.",
               "New one, eh? How do. Sergeant Bellweather. Name? ...Try not to make my afternoon interesting." ] },
    { "on": "Greeted", "if": "?me == 'Officer Crumb', ?me is Person",
      "say": [ "Oh, hello! You're the new one. Crumb. Officer Crumb. And you are? ...Lovely. Kettle's on, if you're nice.",
               "Hello, hello! Crumb. I guard the, er, premises. The kettle, mostly. What do they call you? ...Nice.",
               "How do you do! Officer Crumb. Name? ...Lovely name. Sugar's rationed, but I know a man." ] },
    { "on": "Greeted", "if": "?me == 'Officer Nettles', ?me is Person",
      "say": [ "Hello! Officer Nettles. New, keen, and armed with a clipboard. Name? ...Right, I'll spell it wrong.",
               "Oh! Hello. Inmate! Sorry. Officer Nettles. Name? ...Lovely. Stand there. No, there. I'm taking notes.",
               "Hello. Nettles. I'm the new one too, so we can be nervous together. What's your name? ...Quietly, then." ] },

    // ---- Hello, again: everyone in the Ministry, then one person at a time ----
    { "on": "Chatted", "if": "?me MemberOf 'Ministry of Slop', ?me is Person",
      "say": [ "Hello again. Make it quick, I'm mid-form.", "Afternoon. Or morning. Nobody tells us out here.", "Hm? Oh, hello. It's you.",
               "Still here, I see. Good. Stay that way.", "Hello. Keep it brief, the Ministry bills by the minute.",
               "Oh, hello. Is it about the soup? It's always about the soup." ] },
    { "on": "Chatted", "if": "?me == 'Warden Pettigrew', ?me is Person",
      "say": [ "Section 4, paragraph 9: inmates shall not loiter near the Warden. I'm choosing to ignore it.",
               "Ah, hello again, {them.first}. I'd say 'Warden's orders' but I haven't decided any yet.",
               "Do mind the plants. The Ministry audits them.",
               "I was just reading about you. It's very short.",
               "Ah, {them.first}. Is it a complaint? Complaints go in the box. The box is on the roof." ] },
    { "on": "Chatted", "if": "?me == 'Sergeant Bellweather', ?me is Person",
      "say": [ "Eyes front, {them.first}. Boots down. Soup's at six.",
               "Don't mind me. I'm just counting the exits again.",
               "Quiet day. Which means someone's planning something.",
               "How do, {them.first}. I had a knee before this job. Now I have a rota.",
               "Walk with purpose, {them.first}. It looks like work." ] },
    { "on": "Chatted", "if": "?me == 'Officer Crumb', ?me is Person",
      "say": [ "Kettle's just boiled. I'm not saying that to anyone. Especially not you.",
               "Oh hello, {them.first}. Walk and talk, I say. Well, walk to the kettle and talk.",
               "Don't look at me like that. Somebody has to guard the biscuits.",
               "Shh. The Sergeant's coming. Look busy. Look guilty. Either's fine.",
               "Tea? No. Not allowed. Though if you happened to smell it..." ] },
    { "on": "Chatted", "if": "?me == 'Officer Nettles', ?me is Person",
      "say": [ "{them.first}! I've updated your file. Twice.",
               "Hello! Good morning! Is it morning? I've lost the clipboard. No, got it.",
               "I'm told there's a form for chatting. I'm not allowed to give it to you.",
               "I'm not nervous. It's just a lot of keys, {them.first}.",
               "Careful in the yard. Officer Crumb says the north wall has opinions." ] },

    // ---- Their own story, a piece at a time (once each, for a player who has been through the induction) ----
    { "on": "Chatted", "if": "?me == 'Warden Pettigrew', ?them Inducted", "once": true,
      "say": [ "Between us, {them.first}, I wanted to be a lighthouse keeper. The Ministry had no vacancies.",
               "I wrote the handbook, you know. Four hundred pages. Nobody's read page two." ] },
    { "on": "Chatted", "if": "?me == 'Warden Pettigrew', ?them Inducted", "once": true,
      "say": [ "The colony was meant to be a spa. The forms got crossed. Nobody's corrected them.",
               "A word of warning: the Ministry loves a rule more than a result. Learn the rules." ] },
    { "on": "Chatted", "if": "?me == 'Sergeant Bellweather', ?them Inducted", "once": true,
      "say": [ "Twenty-two years in the Ministry. They gave me a watch. It runs slow. Like the rest of us.",
               "I'm not unkind, {them.first}. I'm just paid not to be anything else." ] },
    { "on": "Chatted", "if": "?me == 'Sergeant Bellweather', ?them Inducted", "once": true,
      "say": [ "Nobody ever escapes the colony. They just get lost, and then they come back. Hungrier.",
               "Do the work, keep your head down, and in a year or two you might make Trusty. Might." ] },
    { "on": "Chatted", "if": "?me == 'Officer Crumb', ?them Inducted", "once": true,
      "say": [ "Don't tell anyone, but I'm saving up for a better kettle. Chrome. Very discreet.",
               "I was meant to be on the Ministry's rocket programme. Ended up on the kettle. It's still pressurised." ] },
    { "on": "Chatted", "if": "?me == 'Officer Crumb', ?them Inducted", "once": true,
      "say": [ "The stew's the only reason I haven't resigned. That and the kettle. Mostly the kettle.",
               "Mind the Sergeant. He's got ears like a bat. And the temper of one that's been woken early." ] },
    { "on": "Chatted", "if": "?me == 'Officer Nettles', ?them Inducted", "once": true,
      "say": [ "I volunteered, {them.first}. Can you believe it? They said it'd be character-building.",
               "The Warden says I'm going places. So far: the yard. And the other yard." ] },

    // ---- Any news? With nothing to tell ----
    { "on": "NoNews", "if": "?me == 'Warden Pettigrew', ?me is Person",
      "say": [ "News? There's a memo. It says there'll be a memo.",
               "The Ministry has announced that it will announce something. Eventually.",
               "No news. Which, in the Ministry, is the best kind." ] },
    { "on": "NoNews", "if": "?me == 'Sergeant Bellweather', ?me is Person",
      "say": [ "News? Nobody's escaped. Nobody's tried. Yet.", "Nothing. That's what makes me nervous.", "Nothing worth the paper. And I haven't got any paper." ] },
    { "on": "NoNews", "if": "?me == 'Officer Crumb', ?me is Person",
      "say": [ "Oh, I've got nothing. I'm hurt that you'd ask. Terribly hurt.",
               "I've heard nothing! Honestly. Sort of. Ask me after tea.",
               "Quiet as a mouse in a library. Which is to say, noisy, but only to mice." ] },
    { "on": "NoNews", "if": "?me == 'Officer Nettles', ?me is Person",
      "say": [ "No news, sir. Madam. Inmate! I'll make a note.", "Nothing to report. I'd tell you if I knew how to report it.", "Nothing, {them.first}. Want me to look busy?" ] },

    // ---- What's this place? ----
    { "on": "AskPlace", "if": "?me MemberOf 'Ministry of Slop'",
      "say": [ "The Ministry of Slop's penal colony. Lovely, isn't it? Don't answer that.",
               "A penal colony. We call it 'rehabilitation with fences'.",
               "It's a place to think about what you've done. And to be counted at six." ] },
    { "on": "AskPlace", "if": "?me == 'Warden Pettigrew', ?me is Person",
      "say": [ "Eight hundred acres, one fence, one handbook. The fence is tidier.",
               "Ice on three sides and the Ministry on the fourth. The ice is friendlier.",
               "A fine colony, {them.first}. Fine, but under-funded. Like the rest of the Ministry." ] },
    { "on": "AskPlace", "if": "?me == 'Sergeant Bellweather', ?me is Person",
      "say": [ "Yard, bunks, mess, wall. That's it. Learn the wall.",
               "The fence keeps you in. The terrain keeps you out of the fence. We call that balance.",
               "A colony. People come in, people do their time, people get hungry. The cycle of life." ] },
    { "on": "AskPlace", "if": "?me == 'Officer Crumb', ?me is Person",
      "say": [ "Mess is that way. Kettle's over there. Forbidden zone is the rest.",
               "It's grim, but it has charm. Like a frozen Tuesday.",
               "North wall, south wall, west wall. East wall's an optimist." ] },
    { "on": "AskPlace", "if": "?me == 'Officer Nettles', ?me is Person",
      "say": [ "The yard's where you stand. The mess is where you eat. The rest is where you shouldn't be.",
               "It's got a map. I'll draw you one. It'll be wrong, but confidently.",
               "It's, um, a penal colony. For inmates. Like you. No offence." ] },
    { "on": "AskPlace", "say": [ "Penal colony. Don't think about it too hard.", "A place. With walls. That's about the size of it." ] },

    // ---- What do you do here? ----
    { "on": "AskSelf", "if": "?me MemberOf 'Ministry of Slop'",
      "say": [ "I stand about officially. It's harder than it looks.", "I keep order. I also keep a clipboard. It's the clipboard that matters." ] },
    { "on": "AskSelf", "if": "?me == 'Warden Pettigrew', ?me is Person",
      "say": [ "I run the place, {them.first}. By the handbook. Mostly.",
               "I sign things. Then I countersign them. It's very rewarding.",
               "I am the Ministry's will in a cardigan." ] },
    { "on": "AskSelf", "if": "?me == 'Sergeant Bellweather', ?me is Person",
      "say": [ "I count heads, {them.first}. Yours is one of them.",
               "I've guarded this place for twenty-two years. The fence is still up. I assume that's me.",
               "I keep the others honest. Cheaper than hiring honest ones." ] },
    { "on": "AskSelf", "if": "?me == 'Officer Crumb', ?me is Person",
      "say": [ "I guard the kettle. And, occasionally, people.",
               "Mostly I stand here and nod. It's called 'visible deterrence'.",
               "I'm in charge of morale. Nobody told me I was. I'm doing my best." ] },
    { "on": "AskSelf", "if": "?me == 'Officer Nettles', ?me is Person",
      "say": [ "I'm training to be a proper guard! At the moment I do the clipboard.",
               "I write down everything. Everything! It's mostly lunch.",
               "I'm on probation. Probably. They gave me keys, so, good sign." ] },
    { "on": "AskSelf", "say": [ "I get by.", "Same as everyone. Work, soup, sleep." ] },

    // ---- Any advice? Before the induction is done, then after, then if the Ministry has noticed the player ----
    // (these two count a clause more than one person's own, so where the player is in the story wins over who is asked)
    { "on": "AskAdvice", "if": "?me MemberOf 'Ministry of Slop', ?me is Person, not ?them Inducted",
      "say": [ "Get on the bus when they shout. They will shout.",
               "Do what the Foreman says at the mine. He's seen worse than you. Not much worse.",
               "Keep up, keep quiet, and don't stand under anything that creaks." ] },
    { "on": "AskAdvice", "if": "?me MemberOf 'Ministry of Slop', ?them Inducted",
      "say": [ "Do the work, mind the wall, keep your file clean.",
               "Be useful. The Ministry likes useful. Mostly because it can't spell 'useless'.",
               "Keep your head down, your hands busy and your paperwork up to date." ] },
    { "on": "AskAdvice", "if": "?me MemberOf 'Ministry of Slop', ?me is Person, ?them Suspicion >= 3",
      "say": [ "I'd stop looking at the fence, if I were you. Everyone's noticed.",
               "The Sergeant has an eye on you. Be boring for a day or two.",
               "Your file's thickening. Don't give it a sequel." ] },
    { "on": "AskAdvice", "if": "?me == 'Warden Pettigrew', ?me is Person",
      "say": [ "Read the handbook. Page two. Don't worry, nobody has.",
               "Always have a form ready. Even if it's the wrong one. Especially then.",
               "Never promise a Warden anything. Promise the Ministry. It forgets." ] },
    { "on": "AskAdvice", "if": "?me == 'Sergeant Bellweather', ?me is Person",
      "say": [ "Don't run. You'll only have to walk back.",
               "Don't pick fights with the guards. We have more keys.",
               "If you must do something daft, do it before six. I finish at six." ] },
    { "on": "AskAdvice", "if": "?me == 'Officer Crumb', ?me is Person",
      "say": [ "Be nice to whoever's on the soup. They decide who gets the lumps.",
               "Don't wake the Sergeant. Or me. Mostly the Sergeant.",
               "If you ever need a kettle, I know a man. Well. I am the man." ] },
    { "on": "AskAdvice", "if": "?me == 'Officer Nettles', ?me is Person",
      "say": [ "Um. Stay out of the yard after dark? I think that's the rule. I'll check.",
               "Say please. It doesn't help, but it's polite.",
               "I'd say keep to the rules, but I haven't memorised them yet. Keep to some of them." ] },
    { "on": "AskAdvice", "say": [ "Keep your head down.", "Work hard, say little.", "Don't believe everything you read on the notice board." ] },

    // ---- Goodbye ----
    { "on": "Bye", "if": "?me MemberOf 'Ministry of Slop', ?me is Person", "chance": 0.7,
      "say": [ "Dismissed.", "Back to your bunk, {them.first}.", "Mind the paperwork.", "Off you go. Keep it legal.", "Right. Carry on. Carry on carrying on." ] },
    { "on": "Bye", "if": "?me == 'Officer Crumb', ?me is Person", "chance": 0.7,
      "say": [ "Cheerio! Don't tell the Sergeant about the kettle.", "Off you go. Mind the puddles.", "Ta-ra! And, er, forget the biscuits." ] },
    { "on": "Bye", "if": "?me == 'Warden Pettigrew', ?me is Person", "chance": 0.7,
      "say": [ "Good day. And remember: the handbook is on your side. Technically.", "Dismissed. Politely. In triplicate.", "Carry on. And mind the forms." ] }
  ]
}
