{
  // What the Order of the Fold's people say (docs/story/STORY.md "The Order of the Fold"; the faith is Story/Factions/Fold.json).
  // The believers quote the scripture as they were taught it; the Open Hand (?me Unroller) quote the same verses and read
  // them the other way. Two clauses outrank everyday words, one ties with them. Lines are at most 110 characters, so a
  // verse is said in pieces.
  "about": "the Order of the Fold's people: blessings, scripture, and the Open Hand's whispers",
  "rules": [
    // ---- Meeting someone ----
    { "on": "Step", "verb": "Greet", "if": "?me MemberOf 'Order of the Fold', not ?me Unroller", "reply": "Greeted",
      "say": [ "Blessed be the centre. I'm {me.first}, of the Order of the Fold.", "Peace of the Rolling on you. {me}.",
        "A new face under the empty sky. I'm {me.first}. Blessed be the centre." ] },
    { "on": "Step", "verb": "Greet", "if": "?me MemberOf 'Order of the Fold', ?me Unroller", "reply": "Greeted",
      "say": [ "{me.first}. I do the washing. Mind the floor, it's wet.", "Hello. {me.first}. Don't let the chaplain bake at you." ] },
    { "on": "Greeted", "if": "?me MemberOf 'Order of the Fold', not ?me Unroller",
      "say": [ "Blessed be the centre, {them.first}.", "{me.first}. The Bakehouse door is always open." ] },

    // ---- Chatting: the scripture as the Order teaches it ----
    { "on": "Step", "verb": "Chat", "if": "?me MemberOf 'Order of the Fold', not ?me Unroller", "reply": "Chatted", "every": "2m",
      "say": [ "In the first days a Hunger came to the edge of the board. It would have eaten the five loaves whole.",
        "The Baker took up the Pin and rolled out from the centre, and the Hunger was rolled under. Blessed be.",
        "Look up, {them.first}. Empty, isn't it? Every star is a layer folded under ours. Nothing is lost.",
        "Dough that is worked again grows tough and tears. Let it rest. That's the whole of the law, really.",
        "The Pin lies in five pieces, one in the deep of each world. Touch them not, or the Hunger rises.",
        "Have you eaten? There's laminate. A thousand layers. A world kept safe in every one.",
        "The Baker went into the oven and was not seen again. We keep the oven warm, just in case." ] },
    { "on": "Chatted", "if": "?me MemberOf 'Order of the Fold', not ?me Unroller",
      "say": [ "Let it rest, {them.first}. Let it rest.", "Blessed be the centre.", "Come to the Bakehouse on a rolling day." ] },
    { "on": "Step", "verb": "Chat", "if": "?me MemberOf 'Order of the Fold', ?me Likes ?them >= 30", "reply": "Chatted", "every": "5m",
      "say": [ "You've a kneader's hands, {them.first}. Have you thought about the Order?",
        "Brother Anselm says the old copies say something different. Brother Anselm needs more sleep.",
        "Some say the Pin is a machine. Some say a lot of things. I say: let it rest." ] },

    // ---- Chatting: the Open Hand, quietly ----
    { "on": "Step", "verb": "Chat", "if": "?me MemberOf 'Order of the Fold', ?me Unroller", "reply": "Chatted", "every": "2m",
      "say": [ "Every star is a layer folded under ours, they say. Under. Pressed flat. Does that sound kept to you?",
        "Nothing is lost, the chaplain says. Then where is it, {them.first}? Where is everyone else?",
        "Why would a Baker who meant well hide the Pin and walk into an oven? Ask yourself that.",
        "The verse says the Hunger rises if you turn the Pin back. It doesn't say what else comes back.",
        "Dough that rests too long goes sour. That's not scripture. That's baking." ] },
    { "on": "Step", "verb": "Chat", "if": "?me MemberOf 'Order of the Fold', ?me Unroller, ?me Likes ?them >= 30", "reply": "Chatted", "every": "5m",
      "say": [ "There are more of us than you'd think. We call ourselves the Open Hand. Don't say it near the chaplain.",
        "The old records weren't lost, {them.first}. They were locked away. Somebody wanted them kept." ] },
    { "on": "Chatted", "if": "?me MemberOf 'Order of the Fold', ?me Unroller",
      "say": [ "Keep your hand open, {them.first}.", "Think about it. That's all I ask.", "Shh. The chaplain's coming." ] },

    // ---- Hurt, and what they see ----
    { "on": "Hurt", "if": "?me MemberOf 'Order of the Fold'",
      "say": [ "Peace! Peace, {them.first}!", "The Baker sees this.", "Why? I've nothing but flour." ] },
    { "on": "Saw", "verb": "Kill", "if": "?me MemberOf 'Order of the Fold', not ?me Unroller",
      "say": [ "Let them rest. Blessed be the centre.", "Another layer folded under. Go gently, {target.first}." ] },
    { "on": "Saw", "verb": "Kill", "if": "?me MemberOf 'Order of the Fold', ?me Unroller",
      "say": [ "And the chaplain will say they're kept in the dough. They're dead, {actor.first}. They're dead." ] }
  ]
}
